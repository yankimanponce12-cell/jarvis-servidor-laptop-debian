#!/usr/bin/env bash
# Lanza Jarvis en esta terminal:  jarvis  [--push-to-talk] [--no-mic] [--mute]
SRC="${BASH_SOURCE[0]}"
while [ -L "$SRC" ]; do  # resuelve el symlink de ~/.local/bin/jarvis
  DIR="$(cd -P "$(dirname "$SRC")" && pwd)"
  SRC="$(readlink "$SRC")"
  [[ "$SRC" != /* ]] && SRC="$DIR/$SRC"
done
ROOT="$(cd -P "$(dirname "$SRC")/.." && pwd)"
cd "$ROOT" || exit 1

PY="$ROOT/venv/bin/python"
if [ ! -x "$PY" ]; then
  echo "Falta el entorno virtual. Crealo con:" >&2
  echo "  python3 -m venv venv && venv/bin/pip install -r requirements.txt" >&2
  exit 1
fi

mkdir -p logs
exec "$PY" -u -m jarvis.main "$@"
